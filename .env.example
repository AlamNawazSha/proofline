# ==============================================================================
# Proofline 2.0 Environment Configuration
# Autonomous Evidence Intelligence, AI Compliance & Cryptographic Verification
# ==============================================================================

APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
DEMO_ENABLED=true

# --- Security & Session Tokens ---
# Required in production: generate with `openssl rand -hex 32`
SESSION_SECRET=dev-secret-change-in-production-only-32chars
ALLOWED_ORIGINS=http://localhost:3000,https://proofline-ruby-three.vercel.app

# --- Cryptographic Release Passport (Ed25519) ---
# If left blank, Proofline generates and manages an internal ephemeral Ed25519 key ring in memory
RECEIPT_SIGNING_KEY_ID=KEY-2025-ED25519-PROD-01
RECEIPT_SIGNING_PRIVATE_KEY=

# --- Enterprise Storage & Multi-Tenant Persistence ---
# Leave blank for built-in in-memory / local SQLite demo mode
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=proofline-private

# S3 / MinIO Object Storage (Optional for large binary document archiving)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=proofline-evidence
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- AI Verification Models & Grounding ---
# Compatible with Gemini or OpenAI endpoints
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# --- Webhook Dispatcher ---
WEBHOOK_SECRET=whsec_99a8bc47f12e84c98762310abcdef123

# --- Document Ingestion & SSRF Safety ---
MAX_UPLOAD_SIZE_MB=15
STRICT_SSRF_ENFORCEMENT=true

# --- Round 3 Feature Flags ---
FEATURE_QUORUM=true
FEATURE_TASKS=true
FEATURE_BENCHMARK_CI=true
