APP_ENV=development
# Supabase keys are SERVER ONLY. Never prefix secret keys with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=proofline-private
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional custom base URL for OpenAI-compatible endpoints (e.g., Gemini or Ollama)
OPENAI_BASE_URL=
# Required in production (APP_ENV=production). Generate with: openssl rand -hex 32
SESSION_SECRET=
DEMO_ENABLED=true
API_INTERNAL_URL=http://127.0.0.1:8000
